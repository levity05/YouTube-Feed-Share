{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "4.8.0",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://lrclib.net/*",
    "https://api.lyrics.ovh/*",
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://cdn.frankerfacez.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/loop.js",
        "src/shared/i18n.js",
        "src/locales/en.js",
        "src/shared/feed.js",
        "src/shared/parse.js",
        "src/shared/shortsrules.js",
        "src/content/collector.js",
        "src/content/panel.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/transcript.js",
        "src/content/ytfetch.js",
        "src/content/frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/ai.js",
        "src/shared/music.js",
        "src/shared/feedrules.js",
        "src/shared/taste.js",
        "src/shared/liverules.js",
        "src/viewer/textpanel.js",
        "src/content/watchtools.js",
        "src/content/queue.js",
        "src/content/resume.js",
        "src/content/audiomode.js",
        "src/content/focusmode.js",
        "src/content/feedfilter.js",
        "src/content/livemode.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "js": [
        "src/shared/i18n.js",
        "src/locales/en.js",
        "src/shared/liverules.js",
        "src/shared/emotes.js",
        "src/content/livechat.js",
        "src/content/twitchchat.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/media.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
